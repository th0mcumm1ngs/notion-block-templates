{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "notion-block-templates",
  "title": "Notion Block Templates",
  "description": "Save and paste Notion block templates via clipboard",
  "icon": "extension-icon.png",
  "author": "thom",
  "categories": ["Productivity"],
  "license": "MIT",
  "platforms": ["macOS"],
  "commands": [
    {
      "name": "index",
      "title": "Notion Block Templates",
      "description": "Browse and paste your saved Notion block templates",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.93.2"
  },
  "devDependencies": {
    "@raycast/utils": "^1.17.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
